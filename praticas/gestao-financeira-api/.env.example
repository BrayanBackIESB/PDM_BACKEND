# String de conexão do MySQL usada pelo Prisma.
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/gestao_financeira"

# Porta em que a API HTTP sobe.
PORT=3000

# Segredo usado para assinar os tokens JWT (troque por um valor forte).
JWT_SECRET="troque-por-um-segredo-forte"

# Validade do token (ex.: 7d, 24h, 30m).
JWT_EXPIRES_IN="7d"
